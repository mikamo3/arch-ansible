#!/usr/sbin/nft -f
# Managed by Ansible (base/egress_guard). Default-deny internet egress.
# Independent of Docker's tables: never flush the whole ruleset here.
{% set eg = security.egress_guard %}

table inet egress_guard
delete table inet egress_guard

table inet egress_guard {
	# Container IPs / network subnets opened temporarily by egress-open.
	set ctr_open {
		type ipv4_addr
		flags interval, timeout
	}

	# Container subnets that may always reach the internet (downloader).
	set ctr_net {
		type ipv4_addr
		flags interval
		elements = { {{ eg.download_subnet }} }
	}

	# Host processes: only root, NTP and the "internet" group (net wrapper).
	chain output {
		type filter hook output priority filter; policy accept;

		oif "lo" accept
		ct state established,related accept

		meta skuid 0 accept
		meta skuid "systemd-timesync" accept
		meta skgid "internet" accept

		# DNS is egress too: only the principals above may query.
		ip daddr {{ eg.dns }} meta l4proto { tcp, udp } th dport 53 jump deny

		# LAN (NFS/iSCSI/SSH) and host-to-container traffic.
		ip daddr { {{ eg.lan }}, 172.16.0.0/12, {{ eg.download_subnet }} } accept
		ip daddr { 224.0.0.0/4, 255.255.255.255 } accept
		ip6 daddr { fe80::/10, ff00::/8 } accept
		meta l4proto ipv6-icmp accept

		jump deny
	}

	chain deny {
		limit rate 10/minute log prefix "egress-guard out: "
		reject with icmpx admin-prohibited
	}

	# Containers on user-defined bridges (compose networks) may not leave
	# the Docker bridges. docker0 stays open for docker build RUN steps.
	# Runs before Docker's own filter chains; replies to inbound connections
	# (published ports) are not "new" and pass.
	chain forward {
		type filter hook forward priority filter - 10; policy accept;

		iifname != "br-*" accept
		oifname "br-*" accept
		ct state != new accept
		ip saddr @ctr_net accept
		ip saddr @ctr_open accept

		limit rate 10/minute log prefix "egress-guard fwd: "
		drop
	}
}
